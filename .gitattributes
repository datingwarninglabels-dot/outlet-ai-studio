# Normalise line endings to LF in the repo. Without this, files authored on
# Windows (or by tooling) land as CRLF and every subsequent `git add`
# prints a wall of "LF will be replaced by CRLF" warnings and churns diffs.
* text=auto eol=lf

# Binary assets — never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.mp4 binary
*.webm binary
