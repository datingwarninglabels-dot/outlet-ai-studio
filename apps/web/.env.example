# Database (Postgres — Supabase, Neon, or local)
DATABASE_URL="postgresql://user:password@host:5432/outlet_ai_studio"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""

# Google sign-in — from Google Cloud Console > APIs & Services > Credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Script/storyboard generation (Create Video) — from console.anthropic.com
ANTHROPIC_API_KEY=""

# Voice generation — from elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=""
# ELEVENLABS_VOICE_ID=""  # optional override; defaults to the "Rachel" premade voice

# Visual (image) and animation (image-to-video) generation — from a
# top-up'd org at dev.runwayml.com. Same key powers both.
RUNWAYML_API_SECRET=""

# Final video assembly (compositing clips + voice + captions into one MP4)
# — from shotstack.io/pricing. $0.30/min pay-as-you-go, 10 free trial
# credits, and a free "stage" sandbox for testing.
SHOTSTACK_API_KEY=""
# SHOTSTACK_ENV="stage"  # set to render against the free sandbox instead of production

# Private object storage for generated media (Cloudflare R2 or S3) — required
# before voice, visual, or animation generation will run; generated media is
# never left at a temporary provider URL.
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
# STORAGE_ENDPOINT=""  # set for R2 (e.g. https://<account_id>.r2.cloudflarestorage.com); leave unset for real S3
# STORAGE_REGION=""     # defaults to "auto", which R2 accepts; set a real region for S3
