# Public marketing site — canonical URL used in metadata, Open Graph tags,
# and the sitemap. Required in production (a startup warning fires if it's
# missing); defaults to http://localhost:3000 in development.
# SITE_URL="https://outletaistudio.com"

# Public support contact shown in the marketing footer. Left unset means no
# contact link is shown at all — never set this to a placeholder or
# not-yet-working address; only set it once a real inbox exists.
# SUPPORT_EMAIL="support@example.com"

# Database (Postgres — Supabase, Neon, or local). In production (Vercel),
# this MUST point at a transaction-mode connection pooler, not a direct
# connection — Supabase's pooler port (6543, not 5432) or Neon's pooled
# endpoint. Each serverless function instance opens its own connection;
# without a pooler, real concurrent traffic can exhaust Postgres's
# connection limit and take the app down. Local dev against a direct
# connection (5432) is fine.
DATABASE_URL="postgresql://user:password@host:5432/outlet_ai_studio"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""

# Google sign-in — from Google Cloud Console > APIs & Services > Credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Script/storyboard generation (Create Video) — from console.anthropic.com
ANTHROPIC_API_KEY=""

# Voice generation — from elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=""
# ELEVENLABS_VOICE_ID=""  # optional override; defaults to the "Rachel" premade voice

# Visual (image) and animation (image-to-video) generation — from a
# top-up'd org at dev.runwayml.com. Same key powers both.
RUNWAYML_API_SECRET=""

# Final video assembly (compositing clips + voice + captions into one MP4)
# — from shotstack.io/pricing. $0.30/min pay-as-you-go, 10 free trial
# credits, and a free "stage" sandbox for testing.
SHOTSTACK_API_KEY=""
# SHOTSTACK_ENV="stage"  # set to render against the free sandbox instead of production

# Private object storage for generated media (Cloudflare R2 or S3) — required
# before voice, visual, or animation generation will run; generated media is
# never left at a temporary provider URL.
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
# STORAGE_ENDPOINT=""  # set for R2 (e.g. https://<account_id>.r2.cloudflarestorage.com); leave unset for real S3
# STORAGE_REGION=""     # defaults to "auto", which R2 accepts; set a real region for S3

# Phase 2, Milestone 1 — background job execution (Trigger.dev). Every
# generation job (script/storyboard/voice/visual/animation/assembly/
# thumbnail/character-images/world-images) now runs as a Trigger.dev task
# instead of synchronously inside a server action — see trigger.config.ts
# and src/trigger/. Sign up at trigger.dev, create a project, then fill
# these in from the dashboard's API Keys and Project settings pages. Local
# dev also needs `npm run trigger:dev` running in a second terminal
# alongside `npm run dev`.
TRIGGER_SECRET_KEY=""
TRIGGER_PROJECT_REF=""

# Phase 2, Milestone 3 — billing (Stripe). See STRIPE.md for the full
# setup walkthrough. Nothing here is ever sent to the browser — Checkout
# and the Billing Portal are both hosted, redirect-based Stripe flows
# created server-side, so no publishable key is needed anywhere.
#
# Secret key — from dashboard.stripe.com/apikeys. Use a test-mode key
# (sk_test_...) until you're ready to accept real payments.
STRIPE_SECRET_KEY=""
# Webhook signing secret — from the endpoint you create at
# dashboard.stripe.com/webhooks (or `stripe listen` for local dev). Used to
# verify that a request to /api/stripe/webhook actually came from Stripe.
STRIPE_WEBHOOK_SECRET=""
# Price IDs for the two paid plans — from dashboard.stripe.com/prices
# (create a recurring monthly Price under a Product for each plan first).
# The Free plan has no Stripe price at all.
STRIPE_PRICE_ID_PRO=""
STRIPE_PRICE_ID_STUDIO=""

# Monthly credit allowance per plan, in cents of real provider cost (see
# lib/cost-estimate.ts — a credit IS a cent of actual provider spend, not
# an invented conversion rate). These are real business numbers nobody has
# approved yet; the app runs with conservative development-only fallbacks
# if unset, but a production deploy should set real values explicitly.
# FREE_PLAN_MONTHLY_CREDIT_CENTS="100"
# PRO_PLAN_MONTHLY_CREDIT_CENTS="2000"
# STUDIO_PLAN_MONTHLY_CREDIT_CENTS="6000"
